# The agent that monitors the machine running SM-Watch itself (compose service "host-agent").
# Unlike the API image it carries journalctl, so it can read the HOST's systemd journal from /host/var/log/journal.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends systemd \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir psutil==6.1.1

WORKDIR /app
COPY backend/agent.py ./agent.py
CMD ["python", "agent.py"]
