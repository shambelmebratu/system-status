# Push mode (recommended). In the dashboard open Servers -> Add server -> Install agent, then set:
#   SMWATCH_URL  = your control plane address (reachable from this server, not localhost)
#   SMWATCH_JOIN = the join token (the part after /api/agent/join/ in the shown command)
# The agent registers itself and appears in the dashboard.
SMWATCH_URL=
SMWATCH_JOIN=
# Pull mode instead (control plane polls this agent): leave SMWATCH_URL empty and set a token (openssl rand -hex 32).
AGENT_TOKEN=

# Local image for development, or docker.io/<dockerhub-user>/sm-watch-agent:<tag> after publishing
AGENT_IMAGE=sm-watch-agent:local

# Bind to the server interface reachable by the control plane.
# Restrict this port with the host firewall/VPN; never expose it to the public internet.
AGENT_BIND_ADDRESS=0.0.0.0
AGENT_PORT=9100

# Optional collection tuning
AGENT_HOST_ROOT=/host
AGENT_PROCFS_PATH=/host/proc
AGENT_DISK_PATH=/host
AGENT_PROCESS_TOP_N=20
AGENT_PROCESS_SAMPLE_SECONDS=0.15
