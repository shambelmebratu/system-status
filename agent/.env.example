# Push mode (recommended): copy the token and URL from the dashboard's "Add server" screen.
# Leave NORTHSTAR_URL empty to run in pull mode instead (the control plane polls this agent).
NORTHSTAR_URL=
# Pull mode: generate with  openssl rand -hex 32
AGENT_TOKEN=

# Local image for development, or docker.io/<dockerhub-user>/northstar-agent:<tag> after publishing
AGENT_IMAGE=northstar-agent:local

# Bind to the server interface reachable by the control plane.
# Restrict this port with the host firewall/VPN; never expose it to the public internet.
AGENT_BIND_ADDRESS=0.0.0.0
AGENT_PORT=9100

# Optional collection tuning
AGENT_HOST_ROOT=/host
AGENT_PROCFS_PATH=/host/proc
AGENT_DISK_PATH=/host
AGENT_PROCESS_TOP_N=20
AGENT_PROCESS_SAMPLE_SECONDS=0.15
