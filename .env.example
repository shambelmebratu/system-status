# Docker Hub account the images are published to by the GitHub Action (the same value as the DOCKERHUB_USERNAME secret).
DOCKERHUB_USERNAME=shambi21
# Which image version to run: latest, a release such as 1.2.3 (recommended for production), or sha-<commit>.
SMWATCH_VERSION=latest
POSTGRES_DB=smwatch
POSTGRES_USER=smwatch
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
# Optional dedicated Fernet key for secrets at rest (default: derived from JWT_SECRET).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Set true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Use 'development' only for local experiments: it disables the insecure-default startup check.
ENVIRONMENT=production
CHECK_INTERVAL_SECONDS=60
# Alerting behaviour (optional)
# ALERT_AFTER_FAILURES=2   consecutive failed checks before a target is declared down (1 = alert immediately)
# REMINDER_MINUTES=30      minimum gap between repeat alerts while a target stays down
# ALERT_RETRY_MINUTES=60   undelivered alerts older than this are dropped instead of retried
# Operational limits (optional; the values shown are the defaults). Nothing here is hard-coded in the app.
# HEARTBEAT_MISSED_REPORTS=3        a push agent is down after this many report intervals of silence ...
# HEARTBEAT_MIN_GRACE_SECONDS=30    ... but never sooner than this
# K8S_REPORT_INTERVAL_SECONDS=30    how often the in-cluster agent reports
# K8S_HEARTBEAT_GRACE_SECONDS=100   silence before a cluster is marked down
# K8S_OFFLINE_SECONDS=120           live cluster queries are refused after this much silence
# K8S_MAX_PENDING_REQUESTS=8        queued dashboard questions per cluster
# LOG_RESULT_TTL_MINUTES=15         fetched logs are deleted after this long
# LOG_PICKUP_TIMEOUT_SECONDS=45     an agent must pick up a log request within this time
# LOG_MAX_PENDING_PER_SERVER=5
# AGENT_MAX_OPEN_POLLS=4            held-open task polls one agent may have
# MAX_REQUEST_BODY_KB=256           largest request body the API accepts (agent answers: MAX_AGENT_RESULT_KB=4096)
# ENROLLMENT_DEFAULT_MINUTES=15     install links: default lifetime
# ENROLLMENT_MAX_MINUTES=1440       install links: longest an admin may choose
# Retention defaults (admins change them in Settings > Data retention & purge)
# CHECK_RETENTION_DAYS=365  METRIC_RETENTION_DAYS=14  ALERT_RETENTION_DAYS=90  INCIDENT_RETENTION_DAYS=365  LINK_RETENTION_DAYS=7
# AUDIT_RETENTION_DAYS=365  AUDIT_MIN_RETENTION_DAYS=30
# SCHEDULE_MAX_ATTEMPTS=3  SCHEDULE_RETRY_MINUTES=1  SCHEDULE_MISSED_MINUTES=15   (scheduled messages)
# USAGE_WARN_PERCENT=70  USAGE_BAD_PERCENT=90                                      (colour of usage bars)
# Log access of the bundled host agent (the machine running this stack): on | nodocker | off
# HOST_AGENT_LOGS=on
# Public address of the machine running SM-Watch (shown for the bundled agent). Default: what PUBLIC_URL's host name resolves to.
# HOST_PUBLIC_IP=203.0.113.10
# Address other servers use to reach this control plane; used in agent install commands.
# PUBLIC_URL=https://monitor.example.com
COMPANY_NAME=SM-Watch
BRAND_PRIMARY_COLOR=#c9f36b
BRAND_ACCENT_COLOR=#68d5e8
CPU_THRESHOLD=85
MEMORY_THRESHOLD=90
DISK_THRESHOLD=85
LOAD_THRESHOLD=10
SWAP_THRESHOLD=80
PROCESS_THRESHOLD=80

# Behind a reverse proxy with HTTPS (see deploy/nginx/): only nginx should reach the app, and the session cookie must be Secure.
# FRONTEND_BIND=127.0.0.1
# COOKIE_SECURE=true
# PUBLIC_URL=https://watchstatus.ashewa.com
