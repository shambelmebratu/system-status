# Docker Hub account the images are published to by the GitHub Action (the same value as the DOCKERHUB_USERNAME secret).
DOCKERHUB_USERNAME=shambi21
# Which image version to run: latest, a release such as 1.2.3 (recommended for production), or sha-<commit>.
SMWATCH_VERSION=latest
POSTGRES_DB=smwatch
POSTGRES_USER=smwatch
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
# Optional dedicated Fernet key for secrets at rest (default: derived from JWT_SECRET).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Set true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Use 'development' only for local experiments: it disables the insecure-default startup check.
ENVIRONMENT=production
CHECK_INTERVAL_SECONDS=60
# Alerting behaviour (optional)
# ALERT_AFTER_FAILURES=2   consecutive failed checks before a target is declared down (1 = alert immediately)
# REMINDER_MINUTES=30      minimum gap between repeat alerts while a target stays down
# ALERT_RETRY_MINUTES=60   undelivered alerts older than this are dropped instead of retried
# Operational limits (optional; the values shown are the defaults). Nothing here is hard-coded in the app.
# HEARTBEAT_MISSED_REPORTS=3        a push agent is down after this many report intervals of silence ...
# HEARTBEAT_MIN_GRACE_SECONDS=30    ... but never sooner than this
# K8S_REPORT_INTERVAL_SECONDS=30    how often the in-cluster agent reports
# K8S_HEARTBEAT_GRACE_SECONDS=100   silence before a cluster is marked down
# K8S_OFFLINE_SECONDS=120           live cluster queries are refused after this much silence
# K8S_MAX_PENDING_REQUESTS=8        queued dashboard questions per cluster
# LOG_RESULT_TTL_MINUTES=15         fetched logs are deleted after this long
# LOG_PICKUP_TIMEOUT_SECONDS=45     an agent must pick up a log request within this time
# LOG_MAX_PENDING_PER_SERVER=5
# PUBLIC_STATUS_DEFAULT_DAYS=30   PUBLIC_STATUS_RANGES=7,30,90   public status page: opening time frame and the choices offered (days)
# AGENT_CPU_SAMPLE_SECONDS=5   agent: how often CPU is sampled between two reports (average and peak are reported)
# AGENT_MAX_OPEN_POLLS=4            held-open task polls one agent may have
# MAX_REQUEST_BODY_KB=256           largest request body the API accepts (agent answers: MAX_AGENT_RESULT_KB=4096)
# ENROLLMENT_DEFAULT_MINUTES=15     install links: default lifetime
# ENROLLMENT_MAX_MINUTES=1440       install links: longest an admin may choose
# Retention defaults (admins change them in Settings > Data retention & purge)
# CHECK_RETENTION_DAYS=365  METRIC_RETENTION_DAYS=14  ALERT_RETENTION_DAYS=90  INCIDENT_RETENTION_DAYS=365  LINK_RETENTION_DAYS=7
# AUDIT_RETENTION_DAYS=365  AUDIT_MIN_RETENTION_DAYS=30
# SCHEDULE_MAX_ATTEMPTS=3  SCHEDULE_RETRY_MINUTES=1  SCHEDULE_MISSED_MINUTES=15   (scheduled messages)
# PERF_DEFAULT_WINDOW_MINUTES=10  PERF_MIN_CHECK_SAMPLES=5  PERF_MIN_REQUESTS=50   response-time targets (Performance page)
# TRAFFIC_BUCKETS_MS=5,10,25,50,75,100,150,200,300,500,750,1000,1500,2000,3000,5000,10000   response-time histogram boundaries (ms)
# HOST_ACCESS_LOG=/var/log/nginx/access.log   bundled agent: report response times of real traffic from this access log
# USAGE_WARN_PERCENT=70  USAGE_BAD_PERCENT=90                                      (colour of usage bars)
# Log access of the bundled host agent (the machine running this stack): on | nodocker | off
# HOST_AGENT_LOGS=on
# SSH activity of the bundled host agent (sessions, logins, shell history): on | nohistory | off
# HOST_AGENT_SSH=on
# AI_ENABLED=true   false hides every AI feature (menu, Ask AI, explanations, log analysis) and switches off the AI API
# QA: DNS_RESOLVERS=1.1.1.1,8.8.8.8 (default: system resolver)   TEST_RUN_RETENTION_DAYS=30
# Security: SSH_ATTACK_THRESHOLD=30 (failed SSH logins in 10 min)   SECURITY_SCAN_HOURS=24 (port scan / TLS audit)
#   SSH_SUCCESS_AFTER_FAILURES=5 (a login after this many failures from the same address = possible break-in)   SSH_NEW_SOURCE_ALERTS=true
#   AGENT_THREAT_MINUTES=10  AGENT_UPDATES_HOURS=6   defaults for the agents' threat scan and update check (admins change all three in Security → Schedule)
#   SSH_DAILY_LOGIN_ALERT=4 (alert when a server has more SSH logins than this in a day, even legitimate; 0 = off; admins change it in Security → Schedule)
#   Agent: AGENT_NEW_FILES_HOURS=24 (what counts as a new file/script)  AGENT_NEW_FILES_BURST=50 (new files in one folder that count as a burst)
#   THREAT_ALERT_SEVERITY=high (critical | high | medium | off: which agent threat findings are sent as alerts)
# Agent: AGENT_SECURITY=on|off (SSH logins and failures, pending updates, threat scan, process details)   AGENT_UPDATES_HOURS=6   AGENT_THREAT_MINUTES=10
# AI (optional; pick the provider in AI → Settings). The default "free" provider needs no key. A key set here takes precedence over
# one entered in the dashboard; with no settings saved yet, the first provider whose key is set here is selected. See the README.
# ANTHROPIC_API_KEY=sk-ant-...   OPENAI_API_KEY=sk-...   GEMINI_API_KEY=AIza...   GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...   MISTRAL_API_KEY=...     DEEPSEEK_API_KEY=sk-...  AI_API_KEY=... (custom OpenAI-compatible API)
# OLLAMA_BASE_URL=http://ollama:11434/v1   (default address for the Ollama provider; editable in the dashboard)
# Public address of the machine running SM-Watch (shown for the bundled agent). Default: what PUBLIC_URL's host name resolves to.
# HOST_PUBLIC_IP=203.0.113.10
# Address other servers use to reach this control plane; used in agent install commands.
# PUBLIC_URL=https://monitor.example.com
COMPANY_NAME=SM-Watch
BRAND_PRIMARY_COLOR=#c9f36b
BRAND_ACCENT_COLOR=#68d5e8
CPU_THRESHOLD=85
MEMORY_THRESHOLD=90
DISK_THRESHOLD=85
LOAD_THRESHOLD=10
SWAP_THRESHOLD=80
PROCESS_THRESHOLD=80

# Behind a reverse proxy with HTTPS (see deploy/nginx/): only nginx should reach the app, and the session cookie must be Secure.
# FRONTEND_BIND=127.0.0.1
# COOKIE_SECURE=true
# PUBLIC_URL=https://watchstatus.ashewa.com

# Security (optional)
# TRUSTED_PROXIES=10.0.0.5,10.0.1.0/24   reverse proxies whose X-Forwarded-For is believed. Default: only this machine (nginx on the Docker host). "none" = nobody.
# ALLOW_INSECURE_PULL=false              true = allow pull-mode agents over plain http on public addresses (the agent token is then readable on the network)
# BLOCK_PRIVATE_TARGETS=false            true = service checks / webhooks may not reach private (LAN) addresses either

# Service checks (optional; each service can override them in the dashboard)
# SERVICE_TIMEOUT_SECONDS=10   a slower answer is a failed check
# CERT_ALERT_DAYS=30,14,7      certificate expiry alerts, days before
# CERT_CHECK_HOURS=6           how often each https service's certificate is re-read
