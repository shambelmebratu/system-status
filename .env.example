# Docker Hub account the images are published to by the GitHub Action (the same value as the DOCKERHUB_USERNAME secret).
DOCKERHUB_USERNAME=shambi21
# Which image version to run: latest, a release such as 1.2.3 (recommended for production), or sha-<commit>.
SMWATCH_VERSION=latest
POSTGRES_DB=smwatch
POSTGRES_USER=smwatch
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
# Optional dedicated Fernet key for secrets at rest (default: derived from JWT_SECRET).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Set true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Use 'development' only for local experiments: it disables the insecure-default startup check.
ENVIRONMENT=production
CHECK_INTERVAL_SECONDS=60
# Alerting behaviour (optional)
# ALERT_AFTER_FAILURES=2   consecutive failed checks before a target is declared down (1 = alert immediately)
# REMINDER_MINUTES=30      minimum gap between repeat alerts while a target stays down
# ALERT_RETRY_MINUTES=60   undelivered alerts older than this are dropped instead of retried
# Log access of the bundled host agent (the machine running this stack): on | nodocker | off
# HOST_AGENT_LOGS=on
# Address other servers use to reach this control plane; used in agent install commands.
# PUBLIC_URL=https://monitor.example.com
COMPANY_NAME=SM-Watch
BRAND_PRIMARY_COLOR=#c9f36b
BRAND_ACCENT_COLOR=#68d5e8
CPU_THRESHOLD=85
MEMORY_THRESHOLD=90
DISK_THRESHOLD=85
LOAD_THRESHOLD=10
SWAP_THRESHOLD=80
PROCESS_THRESHOLD=80

# Behind a reverse proxy with HTTPS (see deploy/nginx/): only nginx should reach the app, and the session cookie must be Secure.
# FRONTEND_BIND=127.0.0.1
# COOKIE_SECURE=true
# PUBLIC_URL=https://watchstatus.ashewa.com
